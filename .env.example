# --- Frontend (src/) ---

# VITE_API_BASE_URL: Base URL the frontend's VFS/feedback clients call.
# Production (Vercel) needs nothing here — src/lib/api/vfsClient.ts falls
# back to the relative '/api', which resolves same-origin via vercel.json's
# rewrite to api/index.ts. Local dev needs this set, since the Vite dev
# server (port 3000) and the standalone Express server (port 4000, PORT
# below) are different origins with no dev proxy configured.
VITE_API_BASE_URL="http://localhost:4000/api"

# --- Backend (server/) ---

# PORT: Port the Express backend listens on.
PORT=4000

# NODE_ENV: development | production | test
NODE_ENV=development

# CORS_ORIGIN: Origin allowed to call the backend API (the Vite dev server by default).
CORS_ORIGIN="http://localhost:3000"

# GITHUB_USERNAME: GitHub account GitHubProvider generates workspace content from.
# Optional — if unset, GitHubProvider reports an error status and the "github/"
# folder simply never appears; nothing else in the backend is affected.
GITHUB_USERNAME=""

# GITHUB_TOKEN: Optional static personal access token, used only as a request
# credential (no OAuth/login flow). Raises the unauthenticated GitHub REST API
# rate limit and is required for pinned.md and contributions.md — both are
# GraphQL-only on GitHub's API (pinned repos and the real contribution
# calendar respectively).
GITHUB_TOKEN=""

# LEETCODE_USERNAME: LeetCode account LeetCodeProvider generates workspace
# content from. Optional — if unset, LeetCodeProvider reports an error status
# and the "leetcode/" folder simply never appears; nothing else in the
# backend is affected. No token needed — public profile data only, via
# LeetCode's unauthenticated GraphQL endpoint.


# RESEND_API_KEY: Resend API key used to email contact.sh's Review
# submissions. Optional — if unset, POST /api/feedback returns 503 and the
# rest of contact.sh (the Handoff) is completely unaffected; nothing else
# in the backend is affected. Never exposed to the browser — read only in
# server/email/resendClient.ts.
RESEND_API_KEY=""

# FEEDBACK_TO_EMAIL: Where Review submissions are sent. Optional, same
# degrade-gracefully behavior as RESEND_API_KEY above — both are required
# together for feedback delivery to work.
FEEDBACK_TO_EMAIL=""

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN: REST credentials for
# startup.log's unique-visitor counter (HyperLogLog via @upstash/redis).
# Optional together — if either is unset, POST /api/visitor/visit returns
# 503 and the rest of startup.log is unaffected; the "visitors N" line
# simply doesn't render. Provision via `vercel install upstash` in
# production, or your own Upstash account's REST credentials for local
# testing. Never exposed to the browser — read only in
# server/storage/redisClient.ts.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OWNER_TOKEN: One-time secret used to claim a browser as the site owner's
# own (POST /api/visitor/owner, run via the hidden `owner <token>` terminal
# command) — that browser's future visits are then excluded from the
# unique-visitor count. Optional — if unset, the owner-claim endpoint
# returns 503 rather than crashing backend boot. This excludes a
# *designated browser/device*, not "the owner from every device" — see
# server/routes/visitor.routes.ts's own comment for why that's an honest
# distinction, not a limitation of this implementation specifically.
OWNER_TOKEN=""
